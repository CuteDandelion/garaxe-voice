# Authenticated local PGlite is used when DATABASE_URL is absent. Demo always
# uses its separate temporary PGlite store and never reads DATABASE_URL.
DATABASE_URL=postgresql://user:password@host:5432/garaxe
GARAXE_DB_DIR=.local/pgdata
GARAXE_DEMO_DB_DIR=.local/demo-pgdata
# verify-full is the production default. Use disable only for a private, NetworkPolicy-restricted cluster connection.
GARAXE_DATABASE_SSL_MODE=verify-full
# Optional PEM bundle for a private or provider-specific PostgreSQL certificate authority.
GARAXE_DATABASE_CA_FILE=
GARAXE_ALLOWED_ORIGIN=https://voice.example.com
GARAXE_MAX_BODY_BYTES=5242880
# Trust forwarded client IP headers only behind the production reverse proxy.
GARAXE_TRUST_PROXY=false
# Public Demo admission controls. These are enforced in the temporary Demo database.
GARAXE_DEMO_CLIENT_STARTS_PER_HOUR=3
GARAXE_DEMO_GLOBAL_ACTIVE_RUNS=2
GARAXE_DEMO_CLIENT_ACTIVE_RUNS=1
# Shared authenticated import + analysis admission cap per organization.
GARAXE_ORGANIZATION_ACTIVE_JOB_LIMIT=3
# Local-only source links may use loopback HTTP when explicitly enabled.
GARAXE_ALLOW_LOCAL_HTTP_SOURCE_URLS=false
API_HOST=0.0.0.0
API_PORT=3001
NODE_ENV=production
# Enable only during administrator-controlled first-owner provisioning.
GARAXE_ADMIN_BOOTSTRAP_ENABLED=false

# Supabase Auth uses only the public project URL and publishable key. The
# browser variables are public by design; never add a secret/service key here.
SUPABASE_URL=https://ugkubygaitrlwszygbno.supabase.co
SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=https://ugkubygaitrlwszygbno.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
# Server-only, comma-separated emails for provisioned profiles allowed to monitor the waitlist.
# Never expose this value through a VITE_ variable or browser bundle.
VOICE_LAB_ADMIN_EMAILS=
# Local QA only. Production login never falls back to the legacy staging route.
VITE_LOCAL_QA_AUTH_ENABLED=false

# Production images prewarm these pinned models and disable runtime downloads.
GARAXE_MODEL_CACHE_DIR=/opt/garaxe/models
GARAXE_ALLOW_REMOTE_MODELS=false

# Local-QA owner recovery only. Production mode rejects this route.
GARAXE_DEPLOYMENT_TIER=staging
GARAXE_STAGING_AUTH_ENABLED=false
GARAXE_STAGING_OWNER_EMAIL=test-user@example.com
GARAXE_STAGING_ACCESS_KEY=

# Google OAuth credentials belong in a managed secret store. Never commit values.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://voice.example.com/api/connections/google/callback
GARAXE_OAUTH_ENVELOPE_KEY=
# OpenCode Go — server-side only. Never expose this through Vite/client variables.
OPENCODE_GO_API_KEY=
OPENCODE_GO_BASE_URL=https://opencode.ai/zen/go/v1
OPENCODE_GO_DEFAULT_MODEL=qwen3.7-plus
OPENCODE_GO_ESCALATION_MODEL=qwen3.7-plus
OPENCODE_GO_TIMEOUT_MS=180000

# Optional root-cause-first cluster interpretation. Rate and concurrency limits are always required.
GARAXE_LLM_ENRICHMENT_ENABLED=true
# Guarded local candidate: retain every extracted aspect as an independent evidence unit only when migration 008 is present.
VOICE_LAB_ASPECT_SEMANTICS_ENABLED=false
# Leave spend enforcement off for capacity-priced providers such as OpenCode Go. Turn it on only
# when the provider has a verified monetary pricing contract and all integer-micro limits below apply.
GARAXE_LLM_BUDGET_ENFORCED=false
GARAXE_LLM_GLOBAL_BUDGET_MICRO=5000000
GARAXE_LLM_ORGANIZATION_BUDGET_MICRO=1000000
GARAXE_LLM_PROJECT_BUDGET_MICRO=500000
GARAXE_LLM_RUN_BUDGET_MICRO=100000
GARAXE_LLM_RESERVATION_MICRO=100000
GARAXE_LLM_REQUEST_CAPACITY=2
GARAXE_LLM_REQUESTS_PER_SECOND=0.2
GARAXE_LLM_TOKEN_CAPACITY=16000
GARAXE_LLM_TOKENS_PER_SECOND=500
GARAXE_LLM_GLOBAL_CONCURRENCY=2
GARAXE_LLM_PROVIDER_CONCURRENCY=2
GARAXE_LLM_ORGANIZATION_CONCURRENCY=2
GARAXE_LLM_MAX_OUTPUT_TOKENS=1800
GARAXE_LLM_DEADLINE_MS=240000
