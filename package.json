{
  "name": "garaxe-voice-mvp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch --env-file=.env server/index.ts",
    "dev:web": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "build:web": "vite build",
    "build:server": "esbuild server/index.ts server/migrate.ts --bundle --platform=node --format=esm --packages=external --target=node22 --outdir=dist-server",
    "start:server": "node dist-server/index.js",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run --maxWorkers=1",
    "test:server": "GARAXE_DB_DIR=memory:// vitest run server",
    "test:e2e:public-demo": "tsx scripts/verify-public-demo.ts",
    "test:e2e:public-demo:held-out": "VOICE_MAP_E2E_MATRIX=held-out tsx scripts/verify-public-demo.ts",
    "test:e2e:public-demo:categories": "VOICE_MAP_E2E_MATRIX=balanced-categories tsx scripts/verify-public-demo.ts",
    "test:e2e:public-demo:independent": "VOICE_MAP_E2E_MATRIX=independent-realistic tsx scripts/verify-public-demo.ts",
    "test:e2e:public-demo:incremental": "VOICE_MAP_E2E_MATRIX=incremental tsx scripts/verify-public-demo.ts",
    "test:e2e:authenticated": "tsx --env-file=.env scripts/verify-authenticated-voice-map.ts",
    "test:e2e:authenticated:held-out": "VOICE_MAP_E2E_MATRIX=held-out tsx --env-file=.env scripts/verify-authenticated-voice-map.ts",
    "test:e2e:authenticated:blinded-100": "VOICE_MAP_E2E_MATRIX=blinded-100 tsx --env-file=.env scripts/verify-authenticated-voice-map.ts",
    "test:e2e:authenticated:blinded-100:repeatability": "VOICE_MAP_E2E_MATRIX=blinded-100 VOICE_MAP_PAIR_REPEATABILITY=1 tsx --env-file=.env scripts/verify-authenticated-voice-map.ts",
    "test:e2e:authenticated:categories": "VOICE_MAP_E2E_MATRIX=balanced-categories tsx --env-file=.env scripts/verify-authenticated-voice-map.ts",
    "test:e2e:authenticated:independent": "VOICE_MAP_E2E_MATRIX=independent-realistic tsx --env-file=.env scripts/verify-authenticated-voice-map.ts",
    "test:e2e:authenticated:incremental": "VOICE_MAP_E2E_MATRIX=incremental tsx --env-file=.env scripts/verify-authenticated-voice-map.ts",
    "test:e2e:local-supabase-auth": "tsx --env-file=.env scripts/verify-local-supabase-auth.ts",
    "test:performance:contract": "vitest run scripts/voice-lab-performance-contract.test.ts",
    "evaluate:semantic": "tsx server/evaluation/semanticClusterEvaluator.ts",
    "prewarm:models": "tsx scripts/prewarm-models.ts",
    "typecheck": "tsc -b --pretty false",
    "migrate": "tsx server/migrate.ts",
    "migrate:production": "node dist-server/migrate.js"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@fontsource/cormorant-garamond": "^5.2.8",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/space-grotesk": "^5.2.8",
    "@huggingface/transformers": "^3.8.1",
    "@supabase/supabase-js": "2.112.3",
    "lucide-react": "^0.468.0",
    "pg": "^8.22.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "axe-core": "^4.12.1",
    "concurrently": "^10.0.3",
    "esbuild": "^0.25.0",
    "jsdom": "^25.0.1",
    "tsx": "^4.23.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "3.2.6"
  }
}
